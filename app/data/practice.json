{
  "dialogues": [
    {
      "id": "l1",
      "title": "Ráno v kancelárii",
      "en": "Good morning at the office",
      "requires": [
        "u1"
      ],
      "lines": [
        {
          "v": "A",
          "sk": "Dobrý deň!",
          "en": "Hello!"
        },
        {
          "v": "B",
          "sk": "Dobrý deň. Ako sa máte?",
          "en": "Hello. How are you?"
        },
        {
          "v": "A",
          "sk": "Mám sa dobre, ďakujem. A vy?",
          "en": "I'm well, thank you. And you?"
        },
        {
          "v": "B",
          "sk": "Aj ja, ďakujem. Dovidenia!",
          "en": "Me too, thanks. Goodbye!"
        },
        {
          "v": "A",
          "sk": "Dovidenia!",
          "en": "Goodbye!"
        }
      ],
      "questions": [
        {
          "q": "How is the woman doing?",
          "options": [
            "Well",
            "Badly",
            "She's tired"
          ],
          "answer": 0
        },
        {
          "q": "Do they speak formally or informally?",
          "options": [
            "Formally (vy)",
            "Informally (ty)"
          ],
          "answer": 0
        }
      ]
    },
    {
      "id": "l2",
      "title": "Zoznámenie",
      "en": "Meeting someone",
      "requires": [
        "u2"
      ],
      "lines": [
        {
          "v": "B",
          "sk": "Ahoj, ja som Marek. Ako sa voláš?",
          "en": "Hi, I'm Marek. What's your name?"
        },
        {
          "v": "A",
          "sk": "Ahoj, volám sa Anna. Teší ma.",
          "en": "Hi, my name is Anna. Nice to meet you."
        },
        {
          "v": "B",
          "sk": "Aj mňa. Odkiaľ si?",
          "en": "Likewise. Where are you from?"
        },
        {
          "v": "A",
          "sk": "Som z Ameriky, ale bývam v Bratislave.",
          "en": "I'm from America, but I live in Bratislava."
        },
        {
          "v": "B",
          "sk": "Hovoríš po slovensky?",
          "en": "Do you speak Slovak?"
        },
        {
          "v": "A",
          "sk": "Trochu. Učím sa.",
          "en": "A little. I'm learning."
        }
      ],
      "questions": [
        {
          "q": "Where is Anna from?",
          "options": [
            "America",
            "Slovakia",
            "France"
          ],
          "answer": 0
        },
        {
          "q": "Where does she live now?",
          "options": [
            "Bratislava",
            "Košice",
            "America"
          ],
          "answer": 0
        }
      ]
    },
    {
      "id": "l18",
      "title": "Na fotke",
      "en": "In the photo",
      "requires": [
        "u3"
      ],
      "lines": [
        {
          "v": "A",
          "sk": "Kto je to na fotke?",
          "en": "Who is that in the photo?"
        },
        {
          "v": "B",
          "sk": "To je moja mama a môj otec.",
          "en": "That's my mom and my dad."
        },
        {
          "v": "A",
          "sk": "A toto?",
          "en": "And this?"
        },
        {
          "v": "B",
          "sk": "Toto je môj brat. A toto je babka.",
          "en": "This is my brother. And this is grandma."
        },
        {
          "v": "A",
          "sk": "Máš aj sestru?",
          "en": "Do you have a sister too?"
        },
        {
          "v": "B",
          "sk": "Áno, mám. Volá sa Eva.",
          "en": "Yes, I do. Her name is Eva."
        }
      ],
      "questions": [
        {
          "q": "Who is in the photo first?",
          "options": [
            "Mom and dad",
            "Brother and sister",
            "Grandma and grandpa"
          ],
          "answer": 0
        },
        {
          "q": "Who else is there?",
          "options": [
            "The brother and grandma",
            "An aunt",
            "The dog"
          ],
          "answer": 0
        },
        {
          "q": "What is the sister called?",
          "options": [
            "Eva",
            "Anna",
            "Nina"
          ],
          "answer": 0
        }
      ]
    },
    {
