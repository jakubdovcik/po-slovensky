          "sk": "Nie, bez mlieka, ďakujem.",
          "en": "No, without milk, thank you."
        },
        {
          "v": "B",
          "sk": "Ešte niečo?",
          "en": "Anything else?"
        },
        {
          "v": "A",
          "sk": "Nie, to je všetko.",
          "en": "No, that's all."
        }
      ],
      "questions": [
        {
          "q": "What does she order?",
          "options": [
            "Coffee and water",
