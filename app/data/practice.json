    {
      "id": "l4",
      "title": "Kde je stanica?",
      "en": "Where's the station?",
      "requires": [
        "u9"
      ],
      "lines": [
        {
          "v": "A",
          "sk": "Prepáčte, kde je stanica?",
          "en": "Excuse me, where is the station?"
        },
        {
          "v": "B",
          "sk": "Stanica? Choďte rovno a potom vľavo.",
          "en": "The station? Go straight and then left."
        },
        {
          "v": "A",
          "sk": "Je to ďaleko?",
          "en": "Is it far?"
        },
        {
          "v": "B",
          "sk": "Nie, je to blízko. Päť minút.",
          "en": "No, it's close. Five minutes."
        },
        {
          "v": "A",
          "sk": "Ďakujem!",
          "en": "Thank you!"
        },
        {
          "v": "B",
          "sk": "Nie je za čo.",
          "en": "You're welcome."
        }
      ],
      "questions": [
        {
          "q": "Which way is the station?",
          "options": [
            "Straight, then left",
            "Straight, then right",
            "Back the way she came"
          ],
          "answer": 0
        },
        {
          "q": "How far is it?",
          "options": [
            "Five minutes",
            "Fifteen minutes",
            "Very far"
          ],
          "answer": 0
        }
      ]
    },
