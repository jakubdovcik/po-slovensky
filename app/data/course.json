    {
      "id": "u7",
      "stage": "survival",
      "title": "Láska · Feelings & love",
      "intro": "Feelings change form with the speaker: a woman says <b>Som šťastná</b> and <b>Mám ťa rada</b>, a man says <b>Som šťastný</b> and <b>Mám ťa rád</b>. These lessons use the version for a woman speaking.",
      "items": [
        {"id":"p_lubimta","sk":"Ľúbim ťa.","en":"I love you."},
        {"id":"p_mamtarada","sk":"Mám ťa rada.","en":"I really like you / love you. (woman speaking)","note":"Warm and a little softer than Ľúbim ťa. Used with family too."},
        {"id":"p_chybasmi","sk":"Chýbaš mi.","en":"I miss you.","note":"Literally \"You are missing to me.\""},
        {"id":"p_stastna","sk":"Som šťastná.","en":"I'm happy. (woman speaking)"},
        {"id":"p_unavena","sk":"Som unavená.","en":"I'm tired. (woman speaking)"},
        {"id":"p_zima","sk":"Je mi zima.","en":"I'm cold.","note":"Literally \"It is winter to me.\""},
        {"id":"p_teplo","sk":"Je mi teplo.","en":"I'm warm / hot."},
        {"id":"p_smutno","sk":"Je mi smutno.","en":"I feel sad."},
        {"id":"w_zlatko","sk":"zlatko","en":"sweetie","note":"Literally \"little gold\"."},
        {"id":"w_milacik","sk":"miláčik","en":"darling"},
        {"id":"p_pusu","sk":"Daj mi pusu.","en":"Give me a kiss."},
        {"id":"p_zlaty","sk":"Si zlatý.","en":"You're a sweetheart. (to a man)"},
        {"id":"p_tesimsa","sk":"Teším sa na teba.","en":"I'm looking forward to seeing you."},
        {"id":"p_poriadku","sk":"Všetko v poriadku?","en":"Is everything OK?"},
        {"id":"p_pohode","sk":"V pohode.","en":"It's fine / No worries."}
      ]
    },
    {
      "id": "u8",
      "stage": "survival",
      "title": "Čas · Time & days",
      "intro": "Days of the week aren't capitalised in Slovak. Most are simply named by number: <b>utorok</b> (2nd), <b>štvrtok</b> (4th), <b>piatok</b> (5th). <b>Streda</b> means \"middle\".",
      "items": [
        {"id":"w_dnes","sk":"dnes","en":"today"},
        {"id":"w_zajtra","sk":"zajtra","en":"tomorrow"},
        {"id":"w_vcera","sk":"včera","en":"yesterday"},
        {"id":"w_teraz","sk":"teraz","en":"now"},
        {"id":"w_neskor","sk":"neskôr","en":"later"},
        {"id":"w_rano","sk":"ráno","en":"morning","g":"n"},
        {"id":"w_vecer","sk":"večer","en":"evening","g":"m"},
        {"id":"w_tyzden","sk":"týždeň","en":"week","g":"m"},
        {"id":"d_po","sk":"pondelok","en":"Monday","g":"m"},
        {"id":"d_ut","sk":"utorok","en":"Tuesday","g":"m"},
        {"id":"d_st","sk":"streda","en":"Wednesday","g":"f"},
