        {"id":"n_3","sk":"tri","en":"three (3)"},
        {"id":"n_4","sk":"štyri","en":"four (4)"},
        {"id":"n_5","sk":"päť","en":"five (5)"},
        {"id":"n_6","sk":"šesť","en":"six (6)"},
        {"id":"n_7","sk":"sedem","en":"seven (7)"},
