    {
      "id": "m3",
      "stage": "clinic",
      "title": "Nálada · Mood & emotions",
      "intro": "Many emotion words are feminine nouns ending in <b>-osť</b> (<i>úzkosť</i>, <i>beznádejnosť</i>), like English \"-ness\". Patients will often describe feelings with <b>Cítim sa…</b> (I feel…) or <b>Je mi…</b> (<i>Je mi smutno</i>, \"I feel sad\").",
      "items": [
        {"id":"m3_nalada","sk":"nálada","en":"mood","g":"f"},
        {"id":"m3_depresia","sk":"depresia","en":"depression","g":"f"},
        {"id":"m3_uzkost","sk":"úzkosť","en":"anxiety","g":"f"},
        {"id":"m3_strach","sk":"strach","en":"fear","g":"m"},
        {"id":"m3_smutok","sk":"smútok","en":"sadness","g":"m"},
        {"id":"m3_hnev","sk":"hnev","en":"anger","g":"m"},
        {"id":"m3_unava","sk":"únava","en":"fatigue / tiredness","g":"f"},
        {"id":"m3_beznadej","sk":"beznádej","en":"hopelessness","g":"f"},
        {"id":"m3_vina","sk":"pocit viny","en":"feeling of guilt","g":"m"},
        {"id":"m3_panika","sk":"záchvat paniky","en":"panic attack","g":"m"},
        {"id":"m3_akanalada","sk":"Aká je vaša nálada?","en":"How is your mood?"},
        {"id":"m3_smutny","sk":"Cítite sa smutný?","en":"Do you feel sad? (to a man)","note":"To a woman: Cítite sa smutná?"},
        {"id":"m3_tesi","sk":"Teší vás ešte niečo?","en":"Does anything still bring you joy?"},
        {"id":"m3_napatie","sk":"Cítim sa nervózna.","en":"I feel nervous. (woman)"},
        {"id":"m3_bojim","sk":"Bojím sa.","en":"I'm afraid."}
